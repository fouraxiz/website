# ---------- Local development (.env.local) ----------
# PostgreSQL connection. Without it the site still runs, using /data as
# read-only content (editing is disabled).
DATABASE_URL=postgres://postgres@127.0.0.1:5432/fouraxiz
# Signs login sessions. 32+ random characters: openssl rand -base64 48
SESSION_SECRET=
# Where uploaded images are stored.
UPLOAD_DIR=./uploads

# Public base URL used for canonical links, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://fouraxiz.com

# Contact form delivery (server-side only). When unset, the form reports
# honestly that online submission is not configured and nothing is sent.
CONTACT_WEBHOOK_URL=

# ---------- Production (.env next to docker-compose.yml) ----------
# POSTGRES_PASSWORD=   # long random password: openssl rand -base64 32
# SESSION_SECRET=
# NEXT_PUBLIC_SITE_URL=https://fouraxiz.com
# CONTACT_WEBHOOK_URL=
